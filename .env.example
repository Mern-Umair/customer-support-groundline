# Copy to apps/web/.env.local (and apps/realtime/.env for the realtime server).

# MongoDB Atlas (M0 free cluster). Database name is part of the URI.
# Prefer the standard (non-SRV) string from Atlas "Connect > Drivers > Standard connection string" if your ISP blocks SRV DNS lookups.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/groundline?retryWrites=true&w=majority

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=

# LLM providers (free tiers). Gemini is used when set; otherwise Groq; otherwise an offline stand-in.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional model overrides (defaults: gemini-3.5-flash-lite, llama-3.3-70b-versatile)
# GEMINI_CHAT_MODEL=
# GROQ_CHAT_MODEL=

# Stripe test mode (optional). Without these, billing shows "not configured" and upgrades are disabled.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (from `stripe listen --forward-to localhost:3000/api/stripe/webhook` or the dashboard)
# STRIPE_PRICE_PRO=price_...        (a recurring price for the Pro plan)

# Realtime (Socket.io) server. Web app → server calls use REALTIME_URL + REALTIME_SECRET;
# browsers connect to NEXT_PUBLIC_REALTIME_URL with tokens signed by AUTH_SECRET.
# Leave REALTIME_URL empty to run without realtime (handoff still works via polling).
REALTIME_URL=http://localhost:4000
REALTIME_SECRET=change-me-shared-with-realtime-server
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# apps/realtime/.env (the realtime server needs these; AUTH_SECRET must match the web app)
# AUTH_SECRET=
# REALTIME_SECRET=
ALLOWED_ORIGINS=http://localhost:3000
PORT=4000
