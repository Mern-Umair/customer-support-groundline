# Copy to apps/web/.env.local (and apps/realtime/.env for the realtime server).

# MongoDB Atlas (M0 free cluster). Database name is part of the URI.
# Prefer the standard (non-SRV) string from Atlas "Connect > Drivers > Standard connection string" if your ISP blocks SRV DNS lookups.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/groundline?retryWrites=true&w=majority

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=

# LLM providers (free tiers). Gemini is used when set; otherwise Groq; otherwise an offline stand-in.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional model overrides (defaults: gemini-3.5-flash-lite, llama-3.3-70b-versatile)
# GEMINI_CHAT_MODEL=
# GROQ_CHAT_MODEL=

# Realtime server
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000
PORT=4000
